{
    "name": "neto737/hestiacp-api",
    "description": "PHP client for the HestiaCP API: users, web domains, mail, DNS, databases, backups, cron jobs and packages",
    "type": "library",
    "keywords": [
        "hestiacp",
        "hestia",
        "hestia-control-panel",
        "control-panel",
        "web-hosting",
        "api",
        "api-client",
        "sdk"
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.15.2 || ^8.2",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "homepage": "https://github.com/neto737/HestiaCP-API",
    "support": {
        "issues": "https://github.com/neto737/HestiaCP-API/issues",
        "source": "https://github.com/neto737/HestiaCP-API",
        "docs": "https://github.com/neto737/HestiaCP-API/tree/main/docs"
    },
    "funding": [
        {
            "type": "liberapay",
            "url": "https://liberapay.com/neto737"
        },
        {
            "type": "custom",
            "url": "https://paypal.me/neto737"
        }
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Neto",
            "email": "neto737@live.com"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "neto737\\HestiaCP\\": "src/HestiaCP/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "neto737\\HestiaCP\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.86",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "analyse": "Run PHPStan static analysis",
        "cs": "Check the coding style",
        "cs-fix": "Fix the coding style",
        "check": "Run the coding-style check, static analysis and tests"
    }
}
